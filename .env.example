# Swarm Conductor — environment template
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Bun loads `.env` automatically at startup.

# DMXAPI key used by the AI planner's PRIMARY backend (claude-opus-4-7).
# Provider: https://www.dmxapi.cn — generate/rotate keys in the dashboard.
DMXAPI_KEY=sk-replace-me

# Optional: override the DMXAPI endpoint (defaults to the public dmxapi.cn URL).
# DMXAPI_URL=https://www.dmxapi.cn/v1/chat/completions

# DeepSeek key used by the AI planner's FALLBACK backend (deepseek-chat).
# This is a SEPARATE provider with its own endpoint and key — not DMXAPI.
# Get one at https://platform.deepseek.com.
DEEPSEEK_API_KEY=sk-replace-me

# Optional: override DeepSeek endpoint / model (official defaults shown).
# DEEPSEEK_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_MODEL=deepseek-chat
